# ══════════════════════════════════════════════════════════════════
#  ATKDecom / PDScope  .gitignore
#  规则说明：注释 + 分节，便于日后增删。以 / 结尾表示只匹配目录。
# ══════════════════════════════════════════════════════════════════

# ── 1. 抓包数据 ───────────────────────────────────────────────────
# 正点原子 PD 抓包原始文件（二进制，体积大且属取样数据，不入库）
*.atkcc
*.atkcc.*

# ── 2. 图片 / 截图 ────────────────────────────────────────────────
# 官方上位机对照截图、界面自检截图等，一律不入库
*.png
*.jpg
*.jpeg
*.jfif
*.gif
*.bmp
*.webp
*.tif
*.tiff
*.ico
*.icns
*.heic
*.avif
*.raw
*.psd
*.ai

# 若日后需要提交某个图片资源（如 logo / 打包图标），用 ! 单独放行。
# 注意：.gitignore 是「后写的规则覆盖先写的」，放行规则必须写在忽略规则之后。
!assets/icon.ico
!assets/icon.icns
!assets/icon.png
!src/ui/assets/**
# 例如：!src/ui/assets/logo.svg

# Tauri 的打包图标（tauri.conf.json → bundle.icon 直接引用这些路径），
# 缺一个就无法构建，必须入库；否则会被上面的 *.png / *.ico / *.icns 吃掉。
!src-tauri/icons/**

# img/ 下的架构图、示意图片等文档配图需要入库（其他目录的图片仍被上面忽略）。
!img/**

# ── 3. 编辑器 / IDE ───────────────────────────────────────────────
.vscode/
.idea/
.vs/
.fleet/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── 4. 智能体 / 本地工作区（含记忆与技能，属本机私有） ─────────────
.workbuddy/
.claude/
.cursor/
.aider*
.continue/

# ── 5. 临时 / 中间过程目录 ────────────────────────────────────────
# _probe 为容器格式与位序的逆向探针脚本；_explore 为解码参数扫描留档
# （不带中间斜杠 = 任意层级同名目录都命中；如需入库，注释掉下面两行）
_probe/
_explore/
tmp/
temp/
.tmp/
.cache/
.turbo/
.parcel-cache/
.sass-cache/
*.tmp
*.bak
*.orig
*.rej
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── 6. 依赖 / 运行时 ──────────────────────────────────────────────
node_modules/
jspm_packages/
bower_components/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── 7. 构建产物 ───────────────────────────────────────────────────
# 注1：dist/ 是「前端产物」目录，但同时供给两种形态，所以刻意不忽略：
#      · dist/PDScope.html —— 单文件免安装版（双击即用），也是 Tauri 桌面版的入口页
#      两份形态共用这一个文件，没有第二个入口，改前端只需重建它。
# 注2：assets/ 与 src-tauri/icons/ 是图标源文件，属源文件，不忽略。
# 注3：artifacts/ 是自检产物（截图 + 报告），属运行产物，整体不入库。
#      单独放一个目录是为了不让它们混进 dist/ —— Tauri 会把 frontendDist 整个打进
#      可执行文件，混进去会白胖将近 1 MB。

artifacts/

# Rust / Tauri 编译产物
src-tauri/target/
src-tauri/gen/
release/
*.pdb

# CI（.github/workflows/build.yml）在仓库根留下的打包产物，都不入库：
#   out/ / portable/         Windows 的暂存目录（安装包、绿色版 exe）
#   PDScope-*.zip            Windows 的成品：安装包版 + 绿色版（-portable）
#   PDScope-*.tar.gz         macOS / Linux 的成品（tar 才保得住可执行位）
#   PDScope-*.sha256         上面各归档的校验和（名字带目标名，防不同目标撞名）
out/
portable/
PDScope-*.zip
PDScope-*.tar.gz
PDScope-*.sha256

# 历史遗留：.NET / Electron 产物（对应方案已废弃，保留规则以防旧目录复现）
bin/
obj/
*.asar
*.asar.unpacked/
.electron-builder-cache/

# ── 8. 操作系统垃圾文件 ───────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.stackdump
