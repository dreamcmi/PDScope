{
  "name": "pdscope",
  "productName": "PDScope",
  "version": "0.1.0",
  "description": "USB Power Delivery 抓包解析上位机 — 直接解析正点原子 ATK-C (.atkcc) 抓包文件",
  "type": "module",
  "author": "PDScope",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build-standalone.mjs",
    "serve": "node tools/serve.mjs",
    "cli": "node tools/cli.js",

    "ver": "node tools/version-check.mjs",
    "syntax": "node tools/syntax.mjs",
    "selftest": "node tools/selftest.js",
    "ackcheck": "node tools/ackcheck.js",
    "e2e": "node tools/e2e.mjs --file dist/PDScope.html --drop \"../制糖40w-ip18pro.atkcc\"",
    "e2e:serve": "node tools/e2e.mjs",
    "test": "node tools/version-check.mjs && node tools/syntax.mjs && node tools/build-standalone.mjs && node tools/selftest.js && node tools/ackcheck.js && npm run e2e",

    "app": "tauri dev",
    "app:exe": "tauri build --no-bundle",
    "app:build": "tauri build",
    "app:test": "node tools/tauri-e2e.mjs --drop \"../制糖40w-ip18pro.atkcc\" --shot artifacts/tauri-shot.png --report artifacts/tauri-selftest.txt",
    "app:test:open": "node tools/tauri-e2e.mjs --open \"../绿联70w-ip18pro.atkcc\" --shot artifacts/tauri-open.png --report artifacts/tauri-open-selftest.txt",
    "app:win": "tauri build --bundles nsis",
    "app:mac": "tauri build --bundles dmg,app",
    "app:linux": "tauri build --bundles appimage,deb",

    "check": "npm test && npm run app:test && npm run app:test:open",

    "icon": "python tools/make-icon.py",
    "icon:tauri": "python tools/make-tauri-icons.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
